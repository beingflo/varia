# The machine `m` runs in (see mise.toml). Agents, dependencies and dev
# servers execute here; the Mac keeps the editor, jj and the deploy.
#
#   mise run vm:up      create if needed, start, install tools and dependencies
#   mise run vm:down    save Pi's sessions to the Mac, then delete the machine
#
# Read when the machine is created: after editing, `mise run vm:down` and
# `mise run vm:up`.

image = "debian:bookworm-slim"
cpus = 4
memory = 6144

workdir = "/workspace"

volumes = [
  ".:/workspace:ro",
  "./ui:/workspace/ui",
  "./server:/workspace/server",
  "./design:/workspace/design",
  "./mise-tasks:/workspace/mise-tasks",
  "./.pi:/workspace/.pi",
  # Dependency stores on the machine's own disk, so no Linux build lands on the Mac.
  "/workspace/ui/node_modules",
  "/workspace/server/target",
  "/workspace/.pi/npm",
]

ports = ["5173:5173", "8099:8099"]

env = [
  "PATH=/root/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
  "MISE_TRUSTED_CONFIG_PATHS=/workspace",
  "VARIA_DB=/var/lib/varia/dev.sqlite",
  "VARIA_BIND_ALL=1",
  "VARIA_ADDR=0.0.0.0:8099",
]

init = [
  "apt-get update -qq && apt-get install -yqq --no-install-recommends git curl ca-certificates build-essential pkg-config unzip xz-utils zstd ripgrep fish >/dev/null",
  "git config --system --add safe.directory '*'",
  "curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh",
  "mise use --global pi@latest",
  "mkdir -p /var/lib/varia /root/.pi/agent",
]

[network]
block_private = true

[[network.credentials]]
name = "deepseek"
environment_variable = "DEEPSEEK_API_KEY"
allowed_hosts = ["api.deepseek.com"]

[[network.credentials]]
name = "openrouter"
environment_variable = "OPENROUTER_API_KEY"
allowed_hosts = ["openrouter.ai"]
