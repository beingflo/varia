[Unit]
Description=varia notes and sync service
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/varia:__TAG__
# Caddy reaches it on the loopback port; nothing else on the host needs it. The
# host side is rendered in by `mise run deploy` from VARIA_PORT, because quadlet
# does no substitution and 8080 already belongs to another service on eos.
PublishPort=127.0.0.1:__PORT__:8080

# The encrypted op log lives in one SQLite file on a named volume. That file is
# the whole server state: a copy of it is a backup, and it is unreadable without
# the client keys anyway.
Volume=varia-data:/data

# Run as the deploying user: keep-id maps the host user onto container uid 1000,
# which is the uid the image declares and the one that already owns the volume.
User=1000:1000
UserNS=keep-id:uid=1000,gid=1000

# It binds 8080 and writes one directory; nothing it execs may gain a capability.
NoNewPrivileges=true
DropCapability=all

# Non-secret configuration is rendered into the Environment= lines below by
# `mise run deploy`. The S3 credentials are podman secrets, so they never appear
# in the unit or the image.
__CONFIG__

Secret=varia-aws-key-id,type=env,target=AWS_ACCESS_KEY_ID
Secret=varia-aws-secret,type=env,target=AWS_SECRET_ACCESS_KEY
# The backup encrypts every object to a public age recipient, which arrives as an
# Environment= line above. Its private half is not installed here at all, so this
# container can write the archive but cannot read it; restoring happens on a
# machine that can unlock the vault, then seeds the volume.
# The optional backup heartbeat; the deploy drops this line when the secret is
# not installed. Its token is the credential — anyone holding it could fake a
# ping — so it is a secret like the S3 keys.
Secret=varia-backup-ping-url,type=env,target=VARIA_BACKUP_PING_URL

[Install]
WantedBy=default.target
