# Non-secret deployment configuration, committed. The op log is encrypted on the
# client, so nothing here is worth hiding; S3 credentials live in
# `.deploy.secrets.enc` and are installed as podman secrets.
# Read by `mise run deploy` (mise-tasks/lib/env.sh).

# The host `mise run deploy` ships to, reached over SSH.
VARIA_HOST="eos"

# The public origin, only used to check the isolation headers after a deploy.
# Caddy (deployment repo) proxies it to 127.0.0.1:8080 — no header configuration
# is needed there: the binary sets COOP/COEP/CORP itself.
VARIA_DOMAIN="varia.page"

# Loopback port the container publishes on the host. 8080 is taken by acta on eos;
# the container itself always listens on 8080 and only the host side moves.
VARIA_PORT=8090

# --- S3 backup --------------------------------------------------------------
# The service uploads one encrypted snapshot of the whole SQLite log every day.
# Backup is on exactly when this bucket is set; leave it empty to run without
# backups. The endpoint is required for anything but AWS; a Backblaze endpoint
# names its own region, so VARIA_S3_REGION stays empty there. The credentials go
# into `.deploy.secrets` as AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY: those
# are the names the S3 client reads, whatever the provider.
#
# The snapshot is encrypted to an age recipient before it leaves the host. Put
# the archive's public key here (`age1...`, from `age-keygen`); its private half
# belongs in the 1Password item "age backup key - varia" and nowhere else, which
# is what makes a restore laptop work. The service refuses to start with the
# backup on and this empty.
#
VARIA_S3_BUCKET=eos-backup
VARIA_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
VARIA_S3_PREFIX=varia
VARIA_BACKUP_HOUR=3
VARIA_BACKUP_MINUTE=30
VARIA_BACKUP_SLOTS=7
VARIA_BACKUP_AGE_RECIPIENT=age15rzkpjml3mgqex6hxklr3tmdp98aefc4eh0ce33tpm5ujemlm4fsw4qww7
