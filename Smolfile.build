# The machine `mise run deploy` builds the image in. It sees the repo read-only
# and nothing else: no writable folders, no keys, no SSH agent, no ports. The
# deploy task on the Mac streams the finished image out and does the SSH part.
#
# Created on the first deploy. `mise run deploy:reset` deletes it, cache and
# all; the next deploy starts clean.

image = "quay.io/podman/stable"
cpus = 4
memory = 6144
net = true

workdir = "/src"

volumes = [
  ".:/src:ro",
  "/var/lib/containers",
]

[network]
block_private = true
