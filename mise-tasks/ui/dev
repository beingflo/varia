#!/usr/bin/env bash
#MISE description="Run the frontend dev server (Vite proxies /api to the service)"
set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/ui"
# A fresh machine starts with an empty node_modules; once it is up to date this
# is a no-op of a second or two.
npm install
exec npm run dev
