#!/usr/bin/env bash
#MISE description="Create/replace the podman secrets (S3 keys, backup heartbeat)"
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
# shellcheck source=/dev/null
source "$root/mise-tasks/lib/env.sh"

# The age key is fetched from 1Password here and nowhere else. `mise run deploy`
# never decrypts anything; it only checks that these secrets exist.
load_deploy_env
load_deploy_secrets

host="${VARIA_HOST:-eos}"
s3_bucket="${VARIA_S3_BUCKET:-}"

create() {
    local name="$1" var="$2" value="${3:-}"
    [[ -n "$value" ]] || die "$var is empty; add it to .deploy.secrets, re-encrypt it, and re-run"
    # The value travels on stdin, so it never appears in the remote argv.
    printf '%s' "$value" | ssh "$host" "podman secret create --replace $name - >/dev/null"
    echo "  ${name}"
}

note "installing podman secrets on ${host}"
if [[ -n "$s3_bucket" ]]; then
    create varia-aws-key-id AWS_ACCESS_KEY_ID "${AWS_ACCESS_KEY_ID:-}"
    create varia-aws-secret AWS_SECRET_ACCESS_KEY "${AWS_SECRET_ACCESS_KEY:-}"
else
    note "VARIA_S3_BUCKET is empty; backup is off, skipping S3 credentials"
fi
# Optional: the URL a monitor watches for the daily backup. It is a credential —
# its token is all anyone needs to send a ping that never happened — so it is a
# secret rather than an `Environment=` line, and it is only installed while a
# backup exists to ping for.
if [[ -n "$s3_bucket" && -n "${VARIA_BACKUP_PING_URL:-}" ]]; then
    create varia-backup-ping-url VARIA_BACKUP_PING_URL "$VARIA_BACKUP_PING_URL"
else
    note "no VARIA_BACKUP_PING_URL; the backup keeps no outside heartbeat"
fi

# A running container keeps the environment it started with, so a rotated secret
# only takes effect after a restart. Skip silently before the first deploy, when
# the unit does not exist yet.
if ssh "$host" 'systemctl --user cat varia >/dev/null 2>&1'; then
    note "restarting varia so the new secrets take effect"
    ssh "$host" 'systemctl --user restart varia'
else
    note "varia is not installed yet; run: mise run deploy"
fi
