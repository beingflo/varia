#!/usr/bin/env bash
#MISE description="Stop the smolvm machine; its disk (and Pi's sessions) is kept"
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
# shellcheck source=mise-tasks/lib/env.sh
source mise-tasks/lib/env.sh

name="${SMOLVM_MACHINE_NAME:-varia}"

command -v smolvm >/dev/null || die "smolvm is not installed"

if ! smolvm machine exec --name "$name" -- true >/dev/null 2>&1; then
    note "machine '$name' is not running"
    exit 0
fi

note "stopping machine '$name'"
smolvm machine stop --name "$name"
