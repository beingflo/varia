#!/usr/bin/env bash
#MISE description="Playwright flows against the built app, Chromium and Firefox"
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
# shellcheck source=/dev/null
source "$root/mise-tasks/lib/env.sh"
cd "$root/ui"

note "chromium"
npx playwright test "$@"
note "firefox"
VARIA_E2E_BROWSERS=firefox npx playwright test "$@"
